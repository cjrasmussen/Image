{
  "name": "cjrasmussen/image",
  "description": "Simple tooling for image manipulation, wrapping native GD functions",
  "version": "3.0.0",
  "keywords": ["gd", "images"],
  "homepage": "https://cjr.dev",
  "license": "MIT",
  "authors": [
    {
      "name": "Clark Rasmussen",
      "homepage": "https://cjr.dev",
      "role": "Developer"
    }
  ],
  "support": {
    "issues": "https://github.com/cjrasmussen/Image/issues",
    "source": "https://github.com/cjrasmussen/Image"
  },
  "require": {
    "php": ">=8.5.0",
    "ext-ctype": "*",
    "ext-gd": "*",
    "cjrasmussen/color": "^3.0",
    "elephox/mimey": "^4.0"
  }
  ,
  "require-dev": {
    "roave/security-advisories": "dev-latest"
  },
  "autoload": {
